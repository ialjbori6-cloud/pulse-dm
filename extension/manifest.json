{
  "manifest_version": 3,
  "name": "PulseDM — Download Catcher",
  "version": "1.0.0",
  "description": "Send links and browser downloads to your local PulseDM segmented downloader.",
  "minimum_chrome_version": "109",
  "permissions": ["contextMenus", "storage", "notifications", "downloads"],
  "host_permissions": ["http://127.0.0.1:8787/*", "http://localhost:8787/*"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "PulseDM",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
